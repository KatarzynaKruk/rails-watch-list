<div class="position-relative mb-4">

  <%= link_to "← Back to main page", root_path, class: "text-light mb-3 d-inline-block" %>

  <div class="card-category">
    <h1><%= @list.name %></h1>
  </div>
  <span class="movie-tag"><%= pluralize(@list.movies.size, "movie") %></span>
</div>

<div class="container mb-5">
  <!-- Actions -->
  <div class="mb-4">
    <% if @list.movies.empty? %>
      <p><small><em class="text-muted">You haven't saved any movies yet!</em></small></p>
    <% end %>

    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#new_movie_modal">
      Add a movie
    </button>

    <%= link_to "Delete this list", list_path(@list), class: "btn btn-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this list?" } %>
  </div>

  <!-- Movies -->
  <div class="row">
    <% @list.movies.each do |movie| %>
      <% bookmark = Bookmark.find_by(list: @list, movie: movie) %>
      <div class="col-12 col-sm-6 mb-4">
        <div class="card h-100">
          <%= image_tag movie.poster_url, alt: movie.title, class: "card-img-top" %>
          <div class="card-body">
            <h5 class="card-title">
              <%= movie.title %>
              <small class="text-muted">• <%= movie.rating %> <i class="fas fa-star text-warning"></i></small>
            </h5>
            <p class="card-text"><%= movie.overview %></p>
            <% if bookmark %>
              <p><i class="fas fa-quote-left me-1"></i><%= bookmark.comment %></p>
              <%= link_to "Delete", bookmark_path(bookmark), class: "text-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to remove #{movie.title} from your list?" } %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <hr class="my-5">

  <!-- Reviews Section -->
  <div class="row">
    <div class="col-12 col-sm-6 mb-4">
      <h3>Reviews</h3>
      <% if @list.reviews.empty? %>
        <p><small><em class="text-muted">Be the first one to review this list</em></small></p>
      <% end %>

      <% @list.reviews.each do |review| %>
        <div class="mb-3">
          <% review.rating.times do %>
            <i class="fas fa-star text-warning"></i>
          <% end %>
          <small class="text-muted"><%= distance_of_time_in_words_to_now(review.created_at) %> ago</small>
          <p><%= review.comment %></p>
          <hr>
        </div>
      <% end %>
    </div>

    <!-- Add Review Form -->
    <div class="col-12 col-sm-6">
      <div class="card p-3">
        <h5>Add your review</h5>
        <%= simple_form_for [@list, @review] do |f| %>
          <div class="mb-2">
            <%= f.input :comment, placeholder: "Add your review here..." %>
          </div>
          <div class="mb-2">
            <%= f.input :rating, as: :select, collection: (1..5), required: true, label: "Rating", input_html: { data: { controller: "star-rating" } } %>
          </div>
          <%= f.submit "Submit", class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= render "bookmarks/modal", list: @list, bookmark: @bookmark %>
